# Deploy the AKS landing zone into an EXISTING hub network (the hub is never deployed).
# Copy and paste the blocks below, in order, into a PowerShell 7.3+ terminal opened at the repository root.
# In VS Code with the Azure CLI Tools extension you can also run a line or selection with Ctrl+' .
# Each deployment shows a What-If; review it and answer y to deploy.
# Before starting, edit environments\<profile>\03-Network-LZ\main.bicepparam with the existing hub values
# (hubResourceGroupName, hubVnetName, firewallIP) and keep aksOutboundType in 05-AKS consistent with firewallIP.
# See docs/existing-hub-walkthrough.md.

# ---- 1. Settings (edit, then paste) ---------------------------------------------------------------------------
$environment = 'minimal'    # minimal (swedencentral), dev (uksouth), or a private copy such as local
$location = 'swedencentral' # region used for the deployment records
$parametersPath = ".\environments\$environment"

$env:AKS_ADMIN_GROUP_ID = '<object-id-of-aks-admins-group>'
$env:AKS_USERS_GROUP_ID = '<object-id-of-aks-users-group>'
$hubSubscriptionId = '<hub-subscription-id>' # same as the workload subscription if the hub is in it

# ---- 2. Sign in and select the workload subscription ----------------------------------------------------------
az login
az account set --subscription '<workload-subscription-id-or-name>'
$subscriptionId = az account show --query id --output tsv
$env:HUB_SUBSCRIPTION_ID = $hubSubscriptionId
$env:DNS_SUBSCRIPTION_ID = $subscriptionId
az account show --query '{name:name, id:id, tenant:tenantId, user:user.name}' --output table

# ---- 3. Pre-checks --------------------------------------------------------------------------------------------
# Validates matching network/AKS inputs and egress.
.\Test-DeploymentConfiguration.ps1 -NetworkParametersFile "$parametersPath\03-Network-LZ\main.bicepparam" -AKSParametersFile "$parametersPath\05-AKS\main.bicepparam"

# Must print Registered. If not: az feature register --namespace Microsoft.Compute --name EncryptionAtHost, wait, then az provider register --namespace Microsoft.Compute
az feature show --namespace Microsoft.Compute --name EncryptionAtHost --subscription $subscriptionId --query properties.state --output tsv

# The existing hub VNet must be reachable. Replace the values with hubResourceGroupName and hubVnetName from the spoke parameters.
az network vnet show --subscription $hubSubscriptionId --resource-group '<hub-resource-group>' --name '<hub-vnet-name>' --query '{name:name, addressSpace:addressSpace.addressPrefixes}' --output json

# ---- 4. Register resource providers ---------------------------------------------------------------------------
$providers = @('Microsoft.Network', 'Microsoft.Storage', 'Microsoft.Compute', 'Microsoft.ManagedIdentity', 'Microsoft.OperationalInsights', 'Microsoft.OperationsManagement', 'Microsoft.ContainerService', 'Microsoft.Insights')
if ($environment -ne 'minimal') { $providers += @('Microsoft.ContainerRegistry', 'Microsoft.KeyVault') }
foreach ($provider in $providers) { az provider register --namespace $provider --subscription $subscriptionId --wait }
# Only when the hub is in another subscription:
# az provider register --namespace Microsoft.Network --subscription $hubSubscriptionId --wait
# az provider register --namespace Microsoft.Insights --subscription $hubSubscriptionId --wait

# ---- 5. Shared monitoring (optional; skip to reuse $env:LOG_ANALYTICS_WORKSPACE_ID) ---------------------------
az deployment sub create --name "$environment-02-monitoring" --location $location --parameters "$parametersPath\02-0-Monitoring\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
$env:LOG_ANALYTICS_WORKSPACE_ID = az deployment sub show --name "$environment-02-monitoring" --subscription $subscriptionId --query properties.outputs.workspaceResourceId.value --output tsv
$env:LOG_ANALYTICS_WORKSPACE_ID

# ---- 6. Private DNS zones (skip if the zones already exist) ---------------------------------------------------
az deployment sub create --name "$environment-03-private-dns-zones" --location $location --parameters "$parametersPath\03-0-DNSZones\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if

# ---- 7. Spoke network, peered with the existing hub -----------------------------------------------------------
az deployment sub create --name "$environment-03-network-spoke" --location $location --parameters "$parametersPath\03-Network-LZ\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
$env:SPOKE_VNET_RESOURCE_ID = az deployment sub show --name "$environment-03-network-spoke" --subscription $subscriptionId --query properties.outputs.vnetResourceId.value --output tsv
$env:SPOKE_VNET_RESOURCE_ID

# ---- 8. Link DNS zones to the spoke ---------------------------------------------------------------------------
az deployment sub create --name "$environment-03-dns-links" --location $location --parameters "$parametersPath\03-0-DNSZones\links.bicepparam" --subscription $subscriptionId --confirm-with-what-if

# ---- 9. AKS supporting services -------------------------------------------------------------------------------
az deployment sub create --name "$environment-04-aks-supporting" --location $location --parameters "$parametersPath\04-AKS-Supporting\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if

# ---- 10. Private AKS cluster (roughly 10-20 minutes) ----------------------------------------------------------
az deployment sub create --name "$environment-05-aks" --location $location --parameters "$parametersPath\05-AKS\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if

# ---- 11. Verify -----------------------------------------------------------------------------------------------
az aks list --subscription $subscriptionId --output table
az deployment sub list --subscription $subscriptionId --query "[?starts_with(name, '$environment-')].{name:name,state:properties.provisioningState}" --output table
