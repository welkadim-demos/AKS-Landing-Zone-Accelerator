# PowerShell 7.3+. Run from the repository root; review each What-If before approving.
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $true

$environment = 'minimal' # minimal, dev or standalone
$location = if ($environment -eq 'minimal') { 'swedencentral' } else { 'uksouth' }
$deployHub = $true # Set false to use an existing hub (in any subscription); standalone has no hub stage.
$deployMonitoring = $true # Shared Log Analytics workspace for diagnostic settings. Set false to skip, or set $env:LOG_ANALYTICS_WORKSPACE_ID to reuse an existing workspace.
$parametersPath = ".\environments\$environment"

# Use the logged-in subscription. Set AKS_HUB_SUBSCRIPTION_ID to deploy or reuse the hub in another subscription (same tenant).
$subscriptionId = az account show --query id --output tsv
if ([string]::IsNullOrWhiteSpace($subscriptionId)) { throw 'No active subscription. Run az login and az account set first.' }
$hubSubscriptionId = if ([string]::IsNullOrWhiteSpace($env:AKS_HUB_SUBSCRIPTION_ID)) { $subscriptionId } else { $env:AKS_HUB_SUBSCRIPTION_ID }
$dnsSubscriptionId = $subscriptionId
$env:HUB_SUBSCRIPTION_ID = $hubSubscriptionId
$env:DNS_SUBSCRIPTION_ID = $dnsSubscriptionId

# All profiles require AKS_ADMIN_GROUP_ID and AKS_USERS_GROUP_ID; standalone also requires AKS_KUBERNETES_VERSION.
.\Test-DeploymentConfiguration.ps1 -NetworkParametersFile "$parametersPath\03-Network-LZ\main.bicepparam" -AKSParametersFile "$parametersPath\05-AKS\main.bicepparam"
if ((az feature show --namespace Microsoft.Compute --name EncryptionAtHost --subscription $subscriptionId --query properties.state --output tsv) -ne 'Registered') {
    throw 'Register Microsoft.Compute/EncryptionAtHost and wait for Registered before deploying. See README.md.'
}

# Register providers and wait until they are ready.
$providers = @('Microsoft.Network', 'Microsoft.Storage', 'Microsoft.Compute', 'Microsoft.ManagedIdentity', 'Microsoft.OperationalInsights', 'Microsoft.OperationsManagement', 'Microsoft.ContainerService', 'Microsoft.Insights')
if ($environment -ne 'minimal') { $providers += @('Microsoft.ContainerRegistry', 'Microsoft.KeyVault') }
foreach ($provider in $providers) {
    az provider register --namespace $provider --subscription $subscriptionId --wait
}
if ($dnsSubscriptionId -ne $subscriptionId) {
    az provider register --namespace Microsoft.Network --subscription $dnsSubscriptionId --wait
    az provider register --namespace Microsoft.ContainerService --subscription $dnsSubscriptionId --wait
}
if ($environment -ne 'standalone' -and $hubSubscriptionId -ne $subscriptionId) {
    az provider register --namespace Microsoft.Network --subscription $hubSubscriptionId --wait
    az provider register --namespace Microsoft.Insights --subscription $hubSubscriptionId --wait
}

# An existing hub must be reachable before the spoke peers with it.
if (-not $deployHub -and $environment -ne 'standalone') {
    $networkParametersFile = Join-Path ([IO.Path]::GetTempPath()) "aks-network-$([guid]::NewGuid()).json"
    az bicep build-params --file "$parametersPath\03-Network-LZ\main.bicepparam" --outfile $networkParametersFile
    $networkParameters = (Get-Content -LiteralPath $networkParametersFile -Raw | ConvertFrom-Json).parameters
    Remove-Item -LiteralPath $networkParametersFile
    az network vnet show --subscription $hubSubscriptionId --resource-group $networkParameters.hubResourceGroupName.value --name $networkParameters.hubVnetName.value --query id --output tsv | Out-Null
}

# Shared Log Analytics workspace (optional). Later stages read LOG_ANALYTICS_WORKSPACE_ID and add diagnostic settings only when it is set.
if ($deployMonitoring -and (Test-Path "$parametersPath\02-0-Monitoring\main.bicepparam")) {
    az deployment sub create --name "$environment-02-monitoring" --location $location --parameters "$parametersPath\02-0-Monitoring\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
    $env:LOG_ANALYTICS_WORKSPACE_ID = az deployment sub show --name "$environment-02-monitoring" --subscription $subscriptionId --query properties.outputs.workspaceResourceId.value --output tsv
    if ([string]::IsNullOrWhiteSpace($env:LOG_ANALYTICS_WORKSPACE_ID)) { throw 'The monitoring deployment did not return a workspace resource ID.' }
}

# Hub (skipped for standalone or when reusing an existing hub).
if ($deployHub -and (Test-Path "$parametersPath\02-Network-Hub\main.bicepparam")) {
    az deployment sub create --name "$environment-02-network-hub" --location $location --parameters "$parametersPath\02-Network-Hub\main.bicepparam" --subscription $hubSubscriptionId --confirm-with-what-if
}

# Private DNS zones.
az deployment sub create --name "$environment-03-private-dns-zones" --location $location --parameters "$parametersPath\03-0-DNSZones\main.bicepparam" --subscription $dnsSubscriptionId --confirm-with-what-if

# Spoke network.
az deployment sub create --name "$environment-03-network-spoke" --location $location --parameters "$parametersPath\03-Network-LZ\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
$env:SPOKE_VNET_RESOURCE_ID = az deployment sub show --name "$environment-03-network-spoke" --subscription $subscriptionId --query properties.outputs.vnetResourceId.value --output tsv
if ([string]::IsNullOrWhiteSpace($env:SPOKE_VNET_RESOURCE_ID)) { throw 'The network deployment did not return a VNet resource ID.' }

# Link DNS zones after the spoke exists.
az deployment sub create --name "$environment-03-dns-links" --location $location --parameters "$parametersPath\03-0-DNSZones\links.bicepparam" --subscription $dnsSubscriptionId --confirm-with-what-if

# Supporting services, then private AKS.
az deployment sub create --name "$environment-04-aks-supporting" --location $location --parameters "$parametersPath\04-AKS-Supporting\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
az deployment sub create --name "$environment-05-aks" --location $location --parameters "$parametersPath\05-AKS\main.bicepparam" --subscription $subscriptionId --confirm-with-what-if
